{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://study.local/schemas/classification.schema.json",
  "title": "1차 분류 동반 TSV 스키마 v1.0",
  "description": "output/<YYMMDD>/*_classification_items.tsv (11열) + *_classification_types.tsv (11열) — ACCEPTANCE_SCHEMA.candidate §1·§2 기반, BOM UTF-8, fail-closed",
  "version": "1.0",
  "created": "2026-09-02",
  "author": "Codex/OMX Sol",
  "references": [
    "docs/templates/CLASSIFICATION_TEMPLATE.md §8",
    "output/260829/ruler-candidate/ACCEPTANCE_SCHEMA.candidate.md",
    "docs/DATA_STANDARD.md §1.3 §3 §5.7-A"
  ],
  "artifacts": {
    "markdown": "output/<YYMMDD>/<YYMMDD>_<NN>_<corpus-id>_classification.md",
    "items_tsv": "output/<YYMMDD>/<YYMMDD>_<NN>_<corpus-id>_classification_items.tsv",
    "types_tsv": "output/<YYMMDD>/<YYMMDD>_<NN>_<corpus-id>_classification_types.tsv"
  },
  "items_tsv": {
    "encoding": "UTF-8 with BOM",
    "delimiter": "\t",
    "header": [
      "item_id",
      "source_lines",
      "rendered_evidence_status",
      "assignment_or_BLOCKED",
      "existing_type_or_decision_request",
      "rationale",
      "tier",
      "tier_basis",
      "observed_trap",
      "confidence",
      "generator_id"
    ],
    "columns": {
      "item_id": {
        "pattern": "^[A-Z]{2,4}-[a-z0-9]{2,8}-\\d{4}([12][MF]|P\\d{2})?-Q\\d{2,3}$",
        "example": "EX-math2-20252M-Q01",
        "unique": true,
        "join_key": "types_tsv.member_item_ids"
      },
      "source_lines": {
        "pattern": "^L\\d+(-L\\d+)?$",
        "forbidden": ["L\\?"],
        "description": "transcript.md 줄번호, L? 금지"
      },
      "rendered_evidence_status": {
        "enum": null,
        "pattern": "^(p\\d+\\.png|no pNN \\(bindata \\d+\\)|unreadable)$",
        "examples": ["p01.png", "no pNN (bindata 3)", "unreadable"]
      },
      "assignment_or_BLOCKED": {
        "pattern": "^([A-Z]{1,3}\\d?-\\d{2}|BLOCKED)$",
        "example": "SM2-14"
      },
      "existing_type_or_decision_request": {
        "pattern": "^([A-Z]{1,3}\\d?-\\d{2}|GAP-[A-Z]+-\\d{2}|BLOCKED)$",
        "example": "GAP-FUNC-01"
      },
      "rationale": { "minLength": 5, "description": "한 문장 근거, 빈칸 금지" },
      "tier": { "enum": ["T1", "T2", "T3", "T4", "TBD"] },
      "tier_basis": { "pattern": "^(catalog [A-Z0-9-]+ Tier|TBD)$" },
      "observed_trap": { "pattern": "^(E\\d{1,2}|-)$" },
      "confidence": { "enum": ["high", "medium", "low"] },
      "generator_id": {
        "pattern": "^([A-Z]{1,3}\\d?-\\d{2}|GAP-[A-Z]+-\\d{2}|BLOCKED-\\d+)$",
        "description": "§2 group_id와 조인, umbrella 금지"
      }
    },
    "rules": [
      "모든 item_id는 transcript 동결 N과 1:1, 중복·결측·초과 0",
      "source_lines에 L? 0건 — 1건이라도 fail-closed",
      "BLOCKED 행은 rendered_evidence_status=unreadable 이고 verify_log.tsv unreadable 행과 1:1",
      "Markdown §1 표와 TSV는 item_id 기준 byte-equal"
    ]
  },
  "types_tsv": {
    "encoding": "UTF-8 with BOM",
    "delimiter": "\t",
    "header": [
      "group_id",
      "member_item_ids",
      "type_disposition",
      "variation_axis_1",
      "variation_axis_2",
      "observed_trap",
      "importance_source_axis",
      "common_types_disposition",
      "catalog_disposition",
      "generator_id",
      "row_kind"
    ],
    "columns": {
      "group_id": {
        "pattern": "^([A-Z]{1,3}\\d?-\\d{2}|GAP-[A-Z]+-\\d{2}|BLOCKED-\\d+)$"
      },
      "member_item_ids": {
        "pattern": "^[A-Z0-9,\\-]+-Q\\d+",
        "description": "콤마 구분 item_id 목록, §1과 문자 일치, 중복 소속 금지"
      },
      "type_disposition": { "enum": ["reusable", "singleton", "blocked"] },
      "variation_axis_1": { "minLength": 3, "required_if": "row_kind=reusable" },
      "variation_axis_2": { "minLength": 3, "required_if": "row_kind=reusable" },
      "observed_trap": { "pattern": "^(E\\d{1,2}|-|—)$" },
      "importance_source_axis": { "minLength": 1 },
      "common_types_disposition": { "minLength": 1 },
      "catalog_disposition": { "enum": ["유지", "신규 제안 후보", "수정 제안", "폐기 제안", "해당 없음"] },
      "generator_id": { "description": "items_tsv.generator_id와 1:1, maximal equivalence" },
      "row_kind": { "enum": ["reusable", "singleton", "blocked"] }
    },
    "rules": [
      "모든 item_id는 정확히 하나의 row에 소속 — 중복·누락·초과 0",
      "reusable는 member 2개 이상 + variation_axis_1·2 둘 다 채움, 아니면 fail-closed",
      "blocked는 HARVEST 재사용 분모에서 제외",
      "row는 generator_id 기준 maximal equivalence — 동일 generator 분할·다른 generator 병합 금지",
      "예상 row 총합 하한·상한 고정 금지 — 관측치는 report-only, item-side generator 재생성과 비교"
    ]
  },
  "gate": {
    "command": "python tools/check_classification.py --check <classification.md>",
    "checks": [
      "expected==observed==TSV rows",
      "L? == 0",
      "reusable 축 2개",
      "Markdown-TSV byte-equal",
      "pNN/bindata 분기 표기",
      "GAP은 CODE_REGISTRY 제안 분리"
    ],
    "verdict": "PASS requires exit 0, warnings 0, failures 0"
  }
}
